.DS_Store

# Per-instance plugin configuration (not versioned)
conf/local/
*/conf/local/

# Notes de suivi locales (non versionnées)
_suivi/

# Fichiers temporaires générés par bookCreator (PDF, HTML intermédiaires).
# On ignore le contenu mais on conserve le dossier (requis par le code, qui
# écrit dedans sans le créer) via .gitkeep.
bookCreator/tmp/*
!bookCreator/tmp/.gitkeep
# The deny rule that keeps generated books from being fetched by their name:
# it must ship with the plugin, so it is excluded from the ignore above.
!bookCreator/tmp/.htaccess

# Plans de cadrage bookCreator v2 : documents de travail locaux, non versionnés.
# Listés unitairement pour ne pas ignorer d'autres .md du plugin par erreur.
bookCreator/plan-1-refonte-bookcreator.md
bookCreator/plan-2-chaine-html-pdf.md
