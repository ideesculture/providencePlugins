.DS_Store

# Per-instance plugin configuration (not versioned)
conf/local/
*/conf/local/

# Notes de suivi locales (non versionnées)
_suivi/

# Fichiers temporaires générés par bookCreator (PDF, HTML intermédiaires).
# On ignore le contenu mais on conserve le dossier (requis par le code, qui
# écrit dedans sans le créer) via .gitkeep.
bookCreator/tmp/*
!bookCreator/tmp/.gitkeep
# The deny rule that keeps generated books from being fetched by their name:
# it must ship with the plugin, so it is excluded from the ignore above.
!bookCreator/tmp/.htaccess

# Plans de cadrage bookCreator v2 : documents de travail locaux, non versionnés.
# Listés unitairement pour ne pas ignorer d'autres .md du plugin par erreur.
bookCreator/plan-1-refonte-bookcreator.md
bookCreator/plan-2-chaine-html-pdf.md

# --- Plugins INRAP (SGA, etatsInrap, exportInrap) ---
# Binaires phantomjs vendorisés (lourds, plusieurs Mo) : non versionnés.
# À redéposer au déploiement d'une instance neuve (cf. message de commit d'ajout).
etatsInrap/lib/phantomjs/
exportInrap/lib/phantomjs/
exportInrap/lib/h2p/bin/
# Sorties etatsInrap générées à l'exécution ; on garde le dossier et son .htaccess.
etatsInrap/tmp/*
!etatsInrap/tmp/.gitkeep
!etatsInrap/tmp/.htaccess
# Rapports d'import SGA générés par lib/update_table.php (dumps HTML, recréés à chaque import).
SGA/views/table_importe.html
SGA/views/table_non_importe.html
# Sauvegardes locales
*.bak
*.bak-*
*.bak_*
*.rejete-*

# importInrap : dépôts de classeurs et fichiers de travail des imports, écrits à l'exécution
# (315 Mo accumulés depuis août 2025). On ignore le contenu, on garde le dossier : le code
# écrit dedans sans le créer.
importInrap/temp/*
!importInrap/temp/.gitkeep
