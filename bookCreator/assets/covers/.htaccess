# Cover PDFs are bound into generated books by the worker; they are never meant
# to be fetched directly. Denying access here keeps a file dropped in this
# directory from becoming publicly readable by its name alone.
#
# Apache 2.4
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
